---
import { site, telHref } from '../data/site';
---
<nav class="callbar" aria-label="Contact rapide">
  <a class="callbar__call" href={telHref} aria-label={`Appeler le ${site.phoneDisplay}`}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
    {site.phoneDisplay}
  </a>
  <a class="callbar__form" href="/contact#form-contact">Décrire mon problème</a>
</nav>
