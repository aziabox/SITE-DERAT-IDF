---
import Logo from './Logo.astro';
import { site, telHref, cta } from '../data/site';
import { primaryNav, navServices, navClients, navZones } from '../data/nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---
<div class="ribbon">
  <div class="wrap ribbon__inner">
    <p style="margin:0">
      Dératisation <b>rats et souris</b> — Paris, petite et grande couronne
    </p>
    <p style="margin:0">
      {site.openingHours} · <a href={telHref}>{site.phoneDisplay}</a>
    </p>
  </div>
</div>

<header class="masthead">
  <div class="wrap masthead__inner">
    <a class="logo" href="/" aria-label={`${site.brand} — accueil`}>
      <Logo class="logo__mark" />
      <span>
        {site.brandMark}
        <small>Rats &amp; souris · Île-de-France</small>
      </span>
    </a>

    <nav class="nav" aria-label="Navigation principale">
      {primaryNav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="masthead__cta">
      <a class="btn btn--outline" href={telHref}>{site.phoneDisplay}</a>
      <a class="btn btn--clay" href="/contact">{cta.primary}</a>
    </div>

    <a class="masthead__tel" href={telHref} aria-label={`Appeler le ${site.phoneDisplay}`}>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
      {site.phoneDisplay}
    </a>

    <details class="menu">
      <summary aria-label="Ouvrir le menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </summary>
      <div class="menu__panel">
        <p class="menu__label">Interventions</p>
        {navServices.map((i) => <a href={i.href}>{i.label}</a>)}
        <p class="menu__label">Qui nous appelle</p>
        {navClients.map((i) => <a href={i.href}>{i.label}</a>)}
        <p class="menu__label">Zones d’intervention</p>
        <a href="/zones-intervention">Toute l’Île-de-France</a>
        {navZones.map((i) => <a href={i.href}>{i.label}</a>)}
        <p class="menu__label">Ressources</p>
        <a href="/blog">Blog</a>
        <a href="/contact">Demander une intervention</a>
      </div>
    </details>
  </div>
</header>
