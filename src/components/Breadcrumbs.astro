---
import type { Crumb } from '../lib/seo';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav class="crumbs" aria-label="Fil d’Ariane">
  <div class="wrap">
    <ol>
      {crumbs.map((c, i) => (
        <li>
          {i === crumbs.length - 1
            ? <span aria-current="page">{c.label}</span>
            : <a href={c.href}>{c.label}</a>}
        </li>
      ))}
    </ol>
  </div>
</nav>
